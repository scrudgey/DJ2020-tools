import json
import networkx as nx

# Replace with your actual JSON file path or load directly from a string
NAV_GRAPH_PATH = '/Users/rfoltz/dev/game-dev/wetworks/Assets/Resources/data/sceneData/mission-x/nav_grid.json'


# 1. Read and parse the serialized Unity json
with open(NAV_GRAPH_PATH, 'r') as f:
    graph_data = json.load(f)

# 2. Instantiate a NetworkX Graph
# Use nx.Graph() for undirected or nx.DiGraph() if your edge directions matter
G = nx.Graph()

# 3. Populate nodes with their spatial attributes
for idx, node in enumerate(graph_data['nodes']):
    G.add_node(
        idx, 
        pos=(node['x'], node['y'], node['z']),  # Full 3D coordinates
        x=node['x'],
        y=node['y'],
        z=node['z']
    )

# 4. Populate edges connecting the indices
for edge in graph_data['edges']:
    G.add_edge(edge['from'], edge['to'])

print(f"Graph loaded successfully.")
print(f"Nodes: {G.number_of_nodes()}")
print(f"Edges: {G.number_of_edges()}")

# Example of accessing node coordinates during post-processing:
# start_node_pos = G.nodes[0]['pos']


node_plot_params = {'node_size': 20, 'node_color':'blue', 'alpha':0.1, 'linewidths':0}
edge_plot_params = {'edge_color':'gray', 'width':1.0, 'alpha':0.5}


fig, ax = plt.subplots(figsize=(20, 20))

# Extract the 2D layout coordinates (X, Z) for each node index
layout_2d = {node_id: (data['x'], data['z']) for node_id, data in G.nodes(data=True)}

# Draw nodes and edges
nx.draw_networkx_nodes(G, pos=layout_2d, ax=ax, **node_plot_params)
nx.draw_networkx_edges(G, pos=layout_2d, ax=ax, **edge_plot_params)

ax.set_title("Unity NavGraph Top-Down Post-Processing View")
ax.set_xlabel("X Axis")
ax.set_ylabel("Z Axis")
ax.tick_params(left=True, bottom=True, labelleft=True, labelbottom=True)
ax.set_aspect('equal')
plt.grid(True, linestyle='--', alpha=0.5)

plt.show()


Y_MIN_CUTOFF = -1 
Y_MAX_CUTOFF = 3

filtered_nodes = [
    idx for idx, data in G.nodes(data=True) 
    if Y_MIN_CUTOFF <= data['y'] <= Y_MAX_CUTOFF
]
subgraph = G.subgraph(filtered_nodes).copy()

print(f"Original Graph: {G.number_of_nodes()} nodes, {G.number_of_edges()} edges")
print(f"Sliced Subgraph ({Y_MIN_CUTOFF} <= Y <= {Y_MAX_CUTOFF}):")
print(f"  Nodes: {subgraph.number_of_nodes()}")
print(f"  Edges: {subgraph.number_of_edges()}")

# --- 4. Plot the Subgraph (Top-Down View) ---
fig, ax = plt.subplots(figsize=(10, 8))

# Map node positions for the 2D layout (X, Z)
subgraph_layout_2d = {
    node_id: (data['x'], data['z']) 
    for node_id, data in subgraph.nodes(data=True)
}

# Draw nodes and edges for the slice
nx.draw_networkx_nodes(
    subgraph, 
    pos=subgraph_layout_2d, 
    ax=ax, 
    **node_plot_params
)
nx.draw_networkx_edges(
    subgraph, 
    pos=subgraph_layout_2d, 
    ax=ax, 
    **edge_plot_params
)

# Styling and Axes
ax.set_title(f"NavGraph Slice ({Y_MIN_CUTOFF} <= Y <= {Y_MAX_CUTOFF})")
ax.set_xlabel("X Axis")
ax.set_ylabel("Z Axis")
ax.tick_params(left=True, bottom=True, labelleft=True, labelbottom=True)
ax.set_aspect('equal')
plt.grid(True, linestyle='--', alpha=0.4)

plt.show()





import json
import networkx as nx
import numpy as np
from sklearn.cluster import DBSCAN

# 1. Load data and extract Y coordinates
with open(NAV_GRAPH_PATH, 'r') as f:
    graph_data = json.load(f)

nodes_list = graph_data['nodes']
y_coords = np.array([[n['y']] for n in nodes_list])

# 2. Automatically detect discrete floors using DBSCAN
# eps=0.5 means nodes within 0.5 units of vertical distance belong to the same floor
db = DBSCAN(eps=0.5, min_samples=1).fit(y_coords)
labels = db.labels_

# Find the unique floor Y-values by taking the average height of each cluster
unique_labels = set(labels)
floor_heights = {}
for label in unique_labels:
    if label != -1:  # Ignore noise if any
        floor_heights[label] = np.mean(y_coords[labels == label])

# Sort floors from lowest to highest elevation
sorted_floors = sorted(floor_heights.items(), key=lambda x: x[1])

print(f"Detected {len(sorted_floors)} distinct floors:")
for floor_idx, (label, height) in enumerate(sorted_floors):
    print(f"  Floor {floor_idx}: Average Height Y = {height:.2f}")

# 3. Build the full graph with floor attributes
G = nx.Graph()
for idx, node in enumerate(nodes_list):
    G.add_node(idx, x=node['x'], y=node['y'], z=node['z'], floor=labels[idx])

for edge in graph_data['edges']:
    G.add_edge(edge['from'], edge['to'])

# 4. Slice the graph into discrete floor subgraphs
floor_subgraphs = {}
for floor_idx, (label, height) in enumerate(sorted_floors):
    # Select nodes belonging to this specific floor label
    floor_nodes = [n for n, attr in G.nodes(data=True) if attr['floor'] == label]
    
    # Create a subgraph containing only these nodes and their connecting edges
    floor_subgraphs[floor_idx] = G.subgraph(floor_nodes).copy()
    
    print(f"    -> Floor {floor_idx} Graph: {floor_subgraphs[floor_idx].number_of_nodes()} nodes")



