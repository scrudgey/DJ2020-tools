import trimesh
import numpy as np
import matplotlib.pyplot as plt
from mpl_toolkits.mplot3d import Axes3D

NAVMESH_PATH = '/Users/rfoltz/dev/game-dev/wetworks/Assets/Resources/data/sceneData/mission-x/NavMeshExport.obj'

# 1. Load the exported Unity NavMesh OBJ
# Trimesh automatically extracts vertices and face indexing arrays
mesh = trimesh.load_mesh(NAVMESH_PATH)

# 2. Extract numeric coordinates into fast NumPy arrays
vertices = np.asarray(mesh.vertices)
faces = np.asarray(mesh.faces)

print(f"Loaded NavMesh with {len(vertices)} vertices and {len(faces)} faces.")
print(f"Bounding Box Dimensions: {mesh.bounds[1] - mesh.bounds[0]}")


fig = plt.figure(figsize=(10, 8))
ax = fig.add_subplot(111, projection='3d')

# Plot the 3D triangular wireframe structure
ax.plot_trisurf(vertices[:, 0], vertices[:, 1], vertices[:, 2], 
                triangles=faces, cmap='viridis', edgecolor='k', alpha=0.6)

ax.set_title("Unity NavMesh Topology Workspace")
ax.set_xlabel("X Axis")
ax.set_ylabel("Y Axis")
ax.set_zlabel("Z Axis (Height)")
plt.show()


fig, ax = plt.subplots(figsize=(10, 8))

x_coords = vertices[:, 0]
y_coords = vertices[:, 1]  # Keep Y for the color value
z_coords = vertices[:, 2]

# Pass y_coords as the 'C' argument to color the mesh by height
mesh_plot = ax.tripcolor(x_coords, z_coords, faces, y_coords, cmap='viridis', alpha=0.7)
ax.triplot(x_coords, z_coords, faces, color='k', linewidth=0.3, alpha=0.5)

fig.colorbar(mesh_plot, ax=ax, label='Elevation (Y Axis)')

ax.set_title("Unity NavMesh Elevation Map")
ax.set_xlabel("X Axis")
ax.set_ylabel("Z Axis")
ax.set_aspect('equal')

plt.show()


