# 1. Load the mesh & restrict by elevation and slope
mesh = trimesh.load_mesh(NAVMESH_PATH, process=True)

y_mask = np.max(mesh.triangles[:, :, 1], axis=1) <= 3
MAX_SLOPE = 55
face_y_normals = np.clip(mesh.face_normals[:, 1], -1.0, 1.0)
face_angles = np.degrees(np.arccos(face_y_normals))
slope_mask = face_angles <= MAX_SLOPE

valid_faces_mask = y_mask & slope_mask
centroids = mesh.triangles.mean(axis=1)

# 2. Extract valid undirected edges
adjacency = mesh.face_adjacency
valid_edges_mask = valid_faces_mask[adjacency[:, 0]] & valid_faces_mask[adjacency[:, 1]]
valid_edges = adjacency[valid_edges_mask]

# Define the flow center based on valid geometry
valid_indices = np.where(valid_faces_mask)[0]
valid_centroids = centroids[valid_faces_mask]
center_x = valid_centroids[:, 0].mean()
center_z = valid_centroids[:, 2].mean()

# 3. Build Adjacency List to easily query node connections
adj = {idx: [] for idx in valid_indices}
for u, v in valid_edges:
    adj[u].append(v)
    adj[v].append(u)

# 4. Generate Flow using Boundary-first BFS
directed_edges = []
processed_edges = set()
queue = deque()

# Step A: Enforce Boundary Conditions (Flow directed from the dead-end INTO the bulk)
for u in valid_indices:
    if len(adj[u]) == 1:
        v = adj[u][0]
        edge_set = frozenset({u, v})
        if edge_set not in processed_edges:
            directed_edges.append((u, v))  # Lock direction into the graph
            processed_edges.add(edge_set)
            queue.append(v)

# Step B: Incrementally extend flow into the bulk, respecting the curl
while queue:
    curr = queue.popleft()
    for nxt in adj[curr]:
        edge_set = frozenset({curr, nxt})
        if edge_set not in processed_edges:
            pos_u = centroids[curr]
            pos_v = centroids[nxt]
            midpoint = (pos_u + pos_v) / 2.0
            
            # Curl vector field V = (-dz, dx)
            flow_vec_x = -(midpoint[2] - center_z)
            flow_vec_z = (midpoint[0] - center_x)
            
            # Check alignment assuming curr -> nxt
            edge_vec_x = pos_v[0] - pos_u[0]
            edge_vec_z = pos_v[2] - pos_u[2]
            alignment = (edge_vec_x * flow_vec_x) + (edge_vec_z * flow_vec_z)
            
            # Align with curl
            # if alignment >= 0:
            directed_edges.append((curr, nxt))
            # else:
            #     directed_edges.append((nxt, curr))
                
            processed_edges.add(edge_set)
            queue.append(nxt)

# Step C: Catch any disconnected cyclic loops not reached by the BFS
for u, v in valid_edges:
    edge_set = frozenset({u, v})
    if edge_set not in processed_edges:
        pos_u = centroids[u]
        pos_v = centroids[v]
        midpoint = (pos_u + pos_v) / 2.0
        
        flow_vec_x = -(midpoint[2] - center_z)
        flow_vec_z = (midpoint[0] - center_x)
        
        edge_vec_x = pos_v[0] - pos_u[0]
        edge_vec_z = pos_v[2] - pos_u[2]
        alignment = (edge_vec_x * flow_vec_x) + (edge_vec_z * flow_vec_z)
        
        if alignment >= 0:
            directed_edges.append((u, v))
        else:
            directed_edges.append((v, u))
            
        processed_edges.add(edge_set)

directed_edges = np.array(directed_edges)

# --- Plotting (2D Top-Down Directed Graph) ---
fig, ax = plt.subplots(figsize=(10, 8))

node_x = centroids[:, 0]
node_z = centroids[:, 2]
node_y = centroids[:, 1]

