def find_chokepoints_node_centrality(G):
    # Compute edge betweenness centrality (best for finding the exact doorway connections)
    edge_centrality = nx.edge_betweenness_centrality(G)
    
    # Compute node betweenness centrality (best for finding the exact doorway tiles)
    node_centrality = nx.betweenness_centrality(G)
    
    # Define a threshold to capture the top percentile of bottleneck nodes (e.g., top 2%)
    threshold = np.percentile(list(node_centrality.values()), 95)
    chokepoint_nodes = [node for node, score in node_centrality.items() if score >= threshold]
    return chokepoint_nodes

def find_chokepoints_bottleneck(G):
    # Find nodes with fewer neighbors (constrained by walls) 
    # but are deeply embedded in the pathing network
    local_bottlenecks = []
    
    for node in G.nodes():
        degree = G.degree(node)
        
        # In a grid of 4-neighbors, open space is 4. Walls/corners reduce this.
        # A hallway tile typically has a degree of 2 (forward/backward).
        if degree <= 2: 
            local_bottlenecks.append(node)
    
    # Combine this with a mild global centrality check to eliminate dead-ends
    node_centrality = nx.betweenness_centrality(G, weight='distance')
    chokepoint_nodes = [n for n in local_bottlenecks if node_centrality[n] > 0.01]
    return chokepoint_nodes


def find_chokepoints_edge_centrality(G):
    # Compute edge betweenness using actual path distances
    edge_centrality = nx.edge_betweenness_centrality(G, weight='distance')
    
    # Find the threshold for the highest bottleneck edges (e.g., top 1%)
    edge_threshold = np.percentile(list(edge_centrality.values()), 99)
    
    # Collect nodes that touch these bottleneck edges
    chokepoint_nodes = set()
    for (u, v), score in edge_centrality.items():
        if score >= edge_threshold:
            chokepoint_nodes.add(u)
            chokepoint_nodes.add(v)
    
    chokepoint_nodes = list(chokepoint_nodes)
    return chokepoint_nodes

def find_doorways(G, room_id_1=0, room_id_2=1):
    # Find the exact bottleneck tiles between Room 0 and Room 1
    room_0_nodes = [n for n, attr in G.nodes(data=True) if attr['room_id'] == room_id_1]
    room_1_nodes = [n for n, attr in G.nodes(data=True) if attr['room_id'] == room_id_2]
    
    # Use a representative node from each room
    source_node = room_0_nodes[0]
    target_node = room_1_nodes[0]
    
    # Returns the exact slice of nodes that forms the narrowest corridor
    doorway_cut = nx.minimum_node_cut(G, s=source_node, t=target_node)





def segment_rooms(G):
    # Initialize room tracking
    node_room_labels = {}
    current_room_id = 0
    
    # Loop through completely separate connected geometric zones
    for component in nx.connected_components(G):
        x = G.subgraph(component)
        
        # If the area is tiny (e.g., a floating artifact or glitch), ignore it
        if x.number_of_nodes() < 5:
            
            # for node in room_nodes:
            #     node_room_labels[node] = current_room_id
            # current_room_id += 1
            continue
            
        # Segment this specific section into rooms
        rooms = nx.community.louvain_communities(x, weight='weight', resolution=0.05)
        
        for room_nodes in rooms:
            for node in room_nodes:
                node_room_labels[node] = current_room_id
            current_room_id += 1
    
    # Apply room assignments back to the main graph
    nx.set_node_attributes(G, node_room_labels, 'room_id')
    print(f"Total valid rooms identified: {current_room_id}")

def segment_rooms_by_density(G, min_degree=3):
    """
    Stabilizes segmentation by temporarily stripping bottleneck nodes,
    leaving clean, isolated room cores.
    """
    # 1. Create a temporary copy to manipulate
    temp_G = G.copy()
    
    # 2. Remove constrained nodes (hallways, doorway tracks, narrow edges)
    # Open grid nodes typically have a degree of 4 (or more with diagonals)
    low_density_nodes = [n for n, deg in temp_G.degree() if deg < min_degree]
    temp_G.remove_nodes_from(low_density_nodes)
    
    # 3. Find remaining fully-connected "room cores"
    room_cores = [c for c in nx.connected_components(temp_G) if len(c) > 4]
    
    # 4. Map the cores to unique room IDs
    node_room_labels = {}
    for room_id, core_nodes in enumerate(room_cores):
        for n in core_nodes:
            node_room_labels[n] = room_id
            
    # 5. Flood-fill the remaining unassigned bottleneck/wall nodes to the nearest room core
    unassigned_nodes = set(G.nodes()) - set(node_room_labels.keys())
    
    for n in unassigned_nodes:
        # Find the closest assigned node using standard BFS shortest path
        closest_room = None
        shortest_dist = float('inf')
        
        for room_id, core_nodes in enumerate(room_cores):
            for core_node in core_nodes:
                try:
                    dist = nx.shortest_path_length(G, source=n, target=core_node)
                    if dist < shortest_dist:
                        shortest_dist = dist
                        closest_room = room_id
                except nx.NetworkXNoPath:
                    continue
        
        node_room_labels[n] = closest_room if closest_room is not None else -1

    return node_room_labels

# Apply stable topological segmentation
room_labels = segment_rooms_by_density(G, min_degree=3)
nx.set_node_attributes(G, room_labels, 'room_id')


import random
import networkx as nx

def flood_fill_by_degree(G):
    # Initialize all nodes to an unassigned room ID (-1)
    room_labels = {node: -1 for node in G.nodes()}
    current_room_id = 0
    
    # Get a list of unassigned nodes to pick from
    unassigned_nodes = set(G.nodes())
    
    while unassigned_nodes:
        # 1. Pick an unassigned starting node (reproducible/stable random choice)
        start_node = random.choice(list(unassigned_nodes))
        
        # Initialize BFS queue for the current room
        queue = [start_node]
        room_labels[start_node] = current_room_id
        unassigned_nodes.remove(start_node)
        
        # 2. Traverse the graph with your custom boundary rule
        while queue:
            current_node = queue.pop(0)
            current_degree = G.degree(current_node)
            
            for neighbor in G.neighbors(current_node):
                if neighbor in unassigned_nodes:
                    neighbor_degree = G.degree(neighbor)
                    
                    # Custom rule: Cannot step from a narrow corridor (degree <= 2) 
                    # into an open area (degree > 2)
                    if current_degree <= 2 and neighbor_degree > 2:
                        continue  # Block the flood-fill from entering the next room
                    
                    # Assign room ID and add to queue
                    room_labels[neighbor] = current_room_id
                    unassigned_nodes.remove(neighbor)
                    queue.append(neighbor)
                    
        # 3. Increment room ID for the next isolated or blocked region
        current_room_id += 1
        
    return room_labels

# Apply the custom algorithm to your graph
room_segmentation = flood_fill_by_degree(G)
nx.set_node_attributes(G, room_segmentation, 'room_id')

print(f"Flood-fill identified {max(room_segmentation.values()) + 1} individual zones.")





